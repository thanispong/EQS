generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "edu", "exam"]
}

// ======================================================
// AUTH
// ======================================================

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users User[]

  @@map("roles")
  @@schema("auth")
}

model User {
  id           Int      @id @default(autoincrement())
  roleId       Int      @map("role_id")
  email        String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  role         Role          @relation(fields: [roleId], references: [id])
  quizAttempts QuizAttempt[]

  @@index([roleId])
  @@map("users")
  @@schema("auth")
}

// ======================================================
// EDUCATION
// ======================================================

model Subject {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdBy   Int?     @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedBy   Int?     @map("updated_by")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  topics Topic[]

  @@unique([name])
  @@map("subjects")
  @@schema("edu")
}

model Topic {
  id          Int      @id @default(autoincrement())
  subjectId   Int      @map("subject_id")
  name        String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdBy   Int?     @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedBy   Int?     @map("updated_by")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  subject Subject @relation(fields: [subjectId], references: [id])
  quizzes Quiz[]

  @@unique([subjectId, name])
  @@index([subjectId])
  @@map("topics")
  @@schema("edu")
}

model Quiz {
  id                Int      @id @default(autoincrement())
  topicId           Int      @map("topic_id")
  title             String
  description       String?
  passingPercentage Decimal  @default(60) @map("passing_percentage") @db.Decimal(5, 2)
  timeLimitMinutes  Int?     @map("time_limit_minutes")
  isShowAnswer      Boolean  @default(false) @map("is_show_answer")
  status            String   @default("draft")
  isActive          Boolean  @default(true) @map("is_active")
  createdBy         Int?     @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedBy         Int?     @map("updated_by")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  topic        Topic         @relation(fields: [topicId], references: [id])
  questions    Question[]
  quizAttempts QuizAttempt[]

  @@index([topicId])
  @@index([status])
  @@map("quizzes")
  @@schema("edu")
}

model Question {
  id           Int      @id @default(autoincrement())
  quizId       Int      @map("quiz_id")
  questionText String   @map("question_text")
  explanation  String?
  score        Decimal  @default(1) @db.Decimal(10, 2)
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdBy    Int?     @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedBy    Int?     @map("updated_by")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  quiz        Quiz             @relation(fields: [quizId], references: [id])
  choices     QuestionChoice[]
  userAnswers UserAnswer[]

  @@unique([quizId, sortOrder])
  @@index([quizId])
  @@map("questions")
  @@schema("edu")
}

model QuestionChoice {
  id         Int      @id @default(autoincrement())
  questionId Int      @map("question_id")
  choiceText String   @map("choice_text")
  isCorrect  Boolean  @default(false) @map("is_correct")
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  question        Question     @relation(fields: [questionId], references: [id])
  selectedAnswers UserAnswer[]

  @@unique([questionId, sortOrder])
  @@index([questionId])
  @@map("question_choices")
  @@schema("edu")
}

// ======================================================
// EXAM
// ======================================================

model QuizAttempt {
  id           Int       @id @default(autoincrement())
  quizId       Int       @map("quiz_id")
  userId       Int       @map("user_id")
  startedAt    DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  submittedAt  DateTime? @map("submitted_at") @db.Timestamptz(3)
  score        Decimal   @default(0) @db.Decimal(10, 2)
  totalScore   Decimal   @default(0) @map("total_score") @db.Decimal(10, 2)
  correctCount Int       @default(0) @map("correct_count")
  wrongCount   Int       @default(0) @map("wrong_count")
  percentage   Decimal   @default(0) @db.Decimal(5, 2)
  isPassed     Boolean?  @map("is_passed")
  status       String    @default("in_progress")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  quiz    Quiz         @relation(fields: [quizId], references: [id])
  user    User         @relation(fields: [userId], references: [id])
  answers UserAnswer[]

  @@index([quizId])
  @@index([userId])
  @@index([status])
  @@map("quiz_attempts")
  @@schema("exam")
}

model UserAnswer {
  id               Int       @id @default(autoincrement())
  quizAttemptId    Int       @map("quiz_attempt_id")
  questionId       Int       @map("question_id")
  selectedChoiceId Int?      @map("selected_choice_id")
  isCorrect        Boolean?  @map("is_correct")
  scoreReceived    Decimal   @default(0) @map("score_received") @db.Decimal(10, 2)
  answeredAt       DateTime? @map("answered_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  quizAttempt    QuizAttempt     @relation(fields: [quizAttemptId], references: [id])
  question       Question        @relation(fields: [questionId], references: [id])
  selectedChoice QuestionChoice? @relation(fields: [selectedChoiceId], references: [id])

  @@unique([quizAttemptId, questionId])
  @@index([quizAttemptId])
  @@index([questionId])
  @@index([selectedChoiceId])
  @@map("user_answers")
  @@schema("exam")
}
